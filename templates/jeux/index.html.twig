{% extends 'base.html.twig' %}

{% block title %}Jeux index{% endblock %}

{% block body %}
    <h1>Jeux index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Date_sortie</th>
                <th>Description</th>
                <th>Detail</th>
                <th>Img</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for jeux in jeuxes %}
            <tr>
                <td>{{ jeux.id }}</td>
                <td>{{ jeux.titre }}</td>
                <td>{{ jeux.dateSortie ? jeux.dateSortie|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ jeux.description }}</td>
                <td>{{ jeux.detail }}</td>
                <td>{{ jeux.img }}</td>
                <td>
                    <a href="{{ path('app_jeux_show', {'id': jeux.id}) }}">show</a>
                    <a href="{{ path('app_jeux_edit', {'id': jeux.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_jeux_new') }}">Create new</a>
{% endblock %}
